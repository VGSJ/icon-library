# Icon Library Environment Configuration
# Copy this file to .env and fill in your values

# REQUIRED: Figma API Credentials
# Get these from: https://www.figma.com/developers/api
# Personal Access Token (not OAuth)
FIGMA_TOKEN=your_personal_access_token_here

# Figma file key where icons are stored
# Found in URL: figma.com/file/{FILE_KEY}/...
FIGMA_FILE_KEY=your_figma_file_key_here

# OPTIONAL: Development Settings
# Enable debug mode (shows additional logging)
DEBUG=false

# Logging level: error, warn, info, debug
LOG_LEVEL=info

# Verbose output for sync operations
VERBOSE=false

# NOTE:
# - NEVER commit .env file (contains sensitive credentials)
# - Always use .env.example as template for new developers
# - Request tokens from your Figma workspace admin if you don't have access
